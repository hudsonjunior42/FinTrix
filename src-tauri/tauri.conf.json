{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinTrix",
  "version": "0.1.0",
  "identifier": "br.com.fintrix.app",
  "build": {
    "frontendDist": "../dist/tauri",
    "beforeDevCommand": "python3 tools/tauri_prep.py",
    "beforeBuildCommand": "python3 tools/tauri_prep.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "FinTrix", "width": 1200, "height": 800, "minWidth": 380, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
