{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinTrix",
  "version": "0.1.0",
  "identifier": "io.github.hudsonjunior42.fintrix",
  "build": {
    "frontendDist": "../dist/tauri",
    "beforeDevCommand": "python3 tools/tauri_prep.py",
    "beforeBuildCommand": "python3 tools/tauri_prep.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self'",
        "frame-src": "blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "Finance",
    "shortDescription": "Controle financeiro pessoal",
    "longDescription": "Contas, cartões, faturas, orçamento e relatórios, com os dados num banco cifrado neste computador.",
    "license": "MIT",
    "publisher": "Hudson",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "fintrix.desktop",
        "files": {
          "/usr/share/icons/hicolor/256x256/apps/io.github.hudsonjunior42.fintrix.png": "icons/128x128@2x.png"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/256x256/apps/io.github.hudsonjunior42.fintrix.png": "icons/128x128@2x.png"
        }
      }
    }
  }
}
