{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinTrix",
  "version": "0.1.0",
  "identifier": "br.com.fintrix.app",
  "build": {
    "frontendDist": "../dist/tauri",
    "beforeDevCommand": "python3 tools/tauri_prep.py",
    "beforeBuildCommand": "python3 tools/tauri_prep.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Finance",
    "shortDescription": "Controle financeiro pessoal",
    "longDescription": "Contas, cartões, faturas, orçamento e relatórios, com os dados num banco cifrado neste computador.",
    "license": "MIT",
    "publisher": "Hudson",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
