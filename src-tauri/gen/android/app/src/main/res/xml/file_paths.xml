<?xml version="1.0" encoding="utf-8"?>
<!-- o que o FileProvider pode entregar a outro app: só o necessário (o padrão do Tauri liberava todo o armazenamento) -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- fotos tiradas pela câmera no "Anexar foto" (RustWebChromeClient do wry) -->
  <external-files-path name="fotos" path="Pictures/" />
  <!-- comprovantes abertos no app do sistema (SistemaPlugin) -->
  <cache-path name="abrir" path="abrir/" />
</paths>
